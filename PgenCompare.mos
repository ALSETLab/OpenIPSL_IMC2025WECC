// Simulate two models and compare Pgen

model1 := "OpenIPSL.Tests.Renewable.PSSE.PVPlant";
model2 := "OpenIPSL.Tests.Renewable.PSSE.PVPlantNew";
stopTime := 5;

simulateModel(model1, stopTime=stopTime, resultFile="result1");
simulateModel(model2, stopTime=stopTime, resultFile="result2");

plot({"pV.RenewableGenerator.Pgen", "pVNew.RenewableGenerator.Pgen"}, legends={"REECB", "REECD"}, plotInAll=true);